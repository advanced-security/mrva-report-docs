[0.808, "o", "\r\n\u001b[?2004l\r"]
[0.005, "o", "sarif-sql is a command-line tool that converts SARIF (Static Analysis Results Interchange Format) files into SQL format for easier data processing and analysis.\r\n\r\nUsage:\r\n  sarif-sql [command]\r\n\r\nAvailable Commands:\r\n  analysis    Manage MRVA analysis lifecycle and SARIF artifacts\r\n  completion  Generate the autocompletion script for the specified shell\r\n  help        Help about any command\r\n  transform   Transform SARIF files into Protobuf format\r\n\r\nFlags:\r\n"]
[0.000, "o", "      --analysis-id string       Analysis ID for the MRVA analysis\r\n      --controller-repo string   Specify the controller repository in owner/name format\r\n  -h, --help                     help for sarif-sql\r\n\r\nUse \"sarif-sql [command] --help\" for more information about a command.\r\n"]
[0.007, "o", "\u001b[?2004h$ "]
